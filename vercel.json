{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...]"
    },
    {
      "source": "/((?!api/|videos/|brochures/|modules/|certificates/|notes/|assets/|src/|node_modules/|@|favicon|robots\\.txt|sitemap\\.xml|site\\.webmanifest|android-chrome|apple-touch-icon).*)",
      "destination": "/index.html"
    }
  ]
}
